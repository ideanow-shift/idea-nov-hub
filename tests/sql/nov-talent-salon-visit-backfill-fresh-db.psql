-- An unexpected fifth eligible event blocks the exact package.
begin;
insert into public.nov_talent_candidates_v1 values('00000000-0000-4000-8000-000000000099',2027,true);
insert into public.nov_talent_recruitment_events_v1 values(
  '00000000-0000-4000-8000-000000000098','00000000-0000-4000-8000-000000000099',
  'SALON_TOUR_COMPLETED','2026-07-01','CONTACTS_27',999,'SALON_TOUR_DATE_1',repeat('9',64),'COMPLETED',true,null,null);
select pg_temp.assert_true((select v->>'state'='BLOCKED' and (v->>'unexpectedSourceEventCount')::integer=1
  from (select nov_talent_internal.salon_visit_2027_backfill_state_v1() v) s),'unexpected source blocks');
rollback;

-- Simulated Audit failure proves the One-Shot function is atomic.
create function pg_temp.reject_salon_audit() returns trigger language plpgsql as $reject$
begin raise exception using errcode='55000',message='TEST_AUDIT_FAILURE'; end
$reject$;
create trigger test_reject_salon_audit before insert on public.nov_talent_recruiting_engagement_audit_v1
for each row execute function pg_temp.reject_salon_audit();
do $atomic$
begin
  begin
    perform * from public.nov_talent_execute_salon_visit_2027_backfill_v1(
      '00000000-0000-4000-8000-000000000009','super_admin',
      '10c87773b376dddaf044dc1c3e2dd88e68b759e2a237df0e406a8a563a192540',
      'ed954ba2a5553ab645d5050cd8ed036aad6e749435d09a9fcfe256255426c023');
    raise exception 'audit failure unexpectedly committed';
  exception when object_not_in_prerequisite_state then null;
  end;
end
$atomic$;
select pg_temp.assert_true((select count(*)=0 from public.nov_talent_recruiting_engagement_facts_v1),'atomic Fact rollback');
select pg_temp.assert_true((select count(*)=0 from public.nov_talent_recruiting_engagement_audit_v1),'atomic Audit rollback');
select pg_temp.assert_true((select count(*)=0 from public.nov_talent_recruiting_salon_visit_backfill_receipts_v1),'atomic receipt rollback');
drop trigger test_reject_salon_audit on public.nov_talent_recruiting_engagement_audit_v1;

create temporary table completed_receipt as
select * from public.nov_talent_execute_salon_visit_2027_backfill_v1(
  '00000000-0000-4000-8000-000000000009','super_admin',
  '10c87773b376dddaf044dc1c3e2dd88e68b759e2a237df0e406a8a563a192540',
  'ed954ba2a5553ab645d5050cd8ed036aad6e749435d09a9fcfe256255426c023');
select pg_temp.assert_true((select fact_count=15 and source_event_count=4 and unique_candidate_count=4 from completed_receipt),'execute receipt counts');
select pg_temp.assert_true((select count(*)=15 and count(distinct candidate_id)=4 and count(distinct store_id)=8
  and count(distinct source_event_id)=4 and count(distinct source_fingerprint)=15
  from public.nov_talent_recruiting_engagement_facts_v1 where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW'),'15 Fact grain');
select pg_temp.assert_true((select count(*)=15 from public.nov_talent_recruiting_engagement_audit_v1 where event_type='FACT_APPENDED'),'15 audit rows');
select pg_temp.assert_true((select count(*)=1 from public.nov_talent_recruiting_salon_visit_backfill_receipts_v1 where receipt_state='COMPLETED'),'one completed receipt');
select pg_temp.assert_true((select count(*)=0 from public.nov_talent_recruiting_actual_backfill_receipts_v1),'CONTACT receipt unchanged');
select pg_temp.assert_true((select count(*)=0 from public.nov_talent_recruiting_engagement_facts_v1 where source_type='CONTACTS_27_HUMAN_REVIEW'),'CONTACT Fact unchanged');
create temporary table salon_happy_path_summary as
select
  (select count(*) from public.nov_talent_recruiting_engagement_facts_v1 where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW') as fact_count,
  (select count(*) from public.nov_talent_recruiting_engagement_audit_v1 where event_type='FACT_APPENDED') as audit_count,
  (select count(*) from public.nov_talent_recruiting_salon_visit_backfill_receipts_v1 where receipt_state='COMPLETED') as receipt_count,
  (select count(distinct candidate_id) from public.nov_talent_recruiting_engagement_facts_v1 where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW') as planning_actual_unique_candidates,
  (select count(distinct source_event_id) from public.nov_talent_recruiting_engagement_facts_v1 where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW') as source_event_count,
  (select count(distinct store_id) from public.nov_talent_recruiting_engagement_facts_v1 where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW') as canonical_store_count;

do $duplicate_execute$
begin
  begin
    perform * from public.nov_talent_execute_salon_visit_2027_backfill_v1(
      '00000000-0000-4000-8000-000000000009','super_admin',
      '10c87773b376dddaf044dc1c3e2dd88e68b759e2a237df0e406a8a563a192540',
      'ed954ba2a5553ab645d5050cd8ed036aad6e749435d09a9fcfe256255426c023');
    raise exception 'duplicate execution unexpectedly succeeded';
  exception when serialization_failure then null;
  end;
end
$duplicate_execute$;
select pg_temp.assert_true((select count(*)=15 from public.nov_talent_recruiting_engagement_facts_v1
  where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW'),'duplicate execute Fact count unchanged');
select pg_temp.assert_true((select count(*)=15 from public.nov_talent_recruiting_engagement_audit_v1
  where event_type='FACT_APPENDED'),'duplicate execute Audit count unchanged');
select pg_temp.assert_true((select count(*)=1 from public.nov_talent_recruiting_salon_visit_backfill_receipts_v1),'duplicate execute receipt count unchanged');

do $append_only$
declare original_id uuid;
begin
  select engagement_fact_id into original_id from public.nov_talent_recruiting_engagement_facts_v1
  where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW' limit 1;
  begin
    update public.nov_talent_recruiting_engagement_facts_v1 set correction_reason='forbidden' where engagement_fact_id=original_id;
    raise exception 'Fact UPDATE unexpectedly succeeded';
  exception when object_not_in_prerequisite_state then null;
  end;
  begin
    delete from public.nov_talent_recruiting_engagement_facts_v1 where engagement_fact_id=original_id;
    raise exception 'Fact DELETE unexpectedly succeeded';
  exception when object_not_in_prerequisite_state then null;
  end;
  begin
    update public.nov_talent_recruiting_salon_visit_backfill_receipts_v1 set reason='forbidden';
    raise exception 'receipt UPDATE unexpectedly succeeded';
  exception when object_not_in_prerequisite_state then null;
  end;
end
$append_only$;

create temporary table void_receipt as
select * from public.nov_talent_void_salon_visit_2027_backfill_v1(
  '00000000-0000-4000-8000-000000000009','super_admin',
  (select backfill_receipt_id from completed_receipt),'Fresh DB append-only void verification');
select pg_temp.assert_true((select cancellation_fact_count=15 from void_receipt),'void count');
select pg_temp.assert_true((select count(*)=15 from public.nov_talent_recruiting_engagement_facts_v1
  where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW_VOID' and engagement_status='CANCELLED'),'15 cancellation Facts');
select pg_temp.assert_true((select count(*)=15 from public.nov_talent_recruiting_engagement_audit_v1
  where event_type='CANCELLATION_APPENDED'),'15 cancellation audits');
select pg_temp.assert_true((select v->>'state'='VOIDED' from (select nov_talent_internal.salon_visit_2027_backfill_state_v1() v) s),'strict VOIDED state');

do $duplicate_void$
begin
  begin
    perform * from public.nov_talent_void_salon_visit_2027_backfill_v1(
      '00000000-0000-4000-8000-000000000009','super_admin',
      (select backfill_receipt_id from completed_receipt),'duplicate void');
    raise exception 'duplicate void unexpectedly succeeded';
  exception when unique_violation then null;
  end;
end
$duplicate_void$;

select pg_temp.assert_true((select count(*)=15 from public.nov_talent_recruiting_engagement_facts_v1
  where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW'),'VOID original Facts unchanged');
select pg_temp.assert_true((select count(*)=15 from public.nov_talent_recruiting_engagement_facts_v1
  where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW_VOID' and correction_of_fact_id is not null),'VOID lineage complete');
select pg_temp.assert_true((select count(*)=2 from public.nov_talent_recruiting_salon_visit_backfill_receipts_v1),'duplicate VOID receipt count unchanged');
select pg_temp.assert_true((select nov_talent_internal.contact_2027_backfill_state_v1()::text=execution_state
  and (select count(*) from public.nov_talent_recruiting_actual_backfill_receipts_v1)=receipt_count
  and (select count(*) from public.nov_talent_recruiting_engagement_facts_v1 where source_type like 'CONTACTS_27_HUMAN_REVIEW%')=fact_count
  and (select count(*) from public.nov_talent_recruiting_engagement_audit_v1 a
    join public.nov_talent_recruiting_engagement_facts_v1 f using (engagement_fact_id)
    where f.source_type like 'CONTACTS_27_HUMAN_REVIEW%')=audit_count
  and (select coalesce(string_agg(source_fingerprint,',' order by source_fingerprint),'')
    from public.nov_talent_recruiting_engagement_facts_v1 where source_type like 'CONTACTS_27_HUMAN_REVIEW%')=fingerprints
  from contact_baseline),'CONTACT preparation remains byte-for-byte independent');

select jsonb_build_object(
  'result','FRESH_DB_SALON_VISIT_BACKFILL_PASS',
  'postgresVersion',current_setting('server_version'),
  'sourceEvents',source_event_count,
  'planningActualUniqueCandidates',planning_actual_unique_candidates,
  'canonicalStores',canonical_store_count,
  'facts',fact_count,
  'audits',audit_count,
  'receipts',receipt_count,
  'voidCancellationFacts',(select count(*) from public.nov_talent_recruiting_engagement_facts_v1 where source_type='CONTACTS_27_SALON_VISIT_HUMAN_REVIEW_VOID'),
  'voidReceipts',(select count(*) from public.nov_talent_recruiting_salon_visit_backfill_receipts_v1 where receipt_state='VOIDED'),
  'contactIndependent',true
) as result
from salon_happy_path_summary;
