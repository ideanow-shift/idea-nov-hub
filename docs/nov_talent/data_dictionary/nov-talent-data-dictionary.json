  },
  "candidateStatuses": [
    {
      "code": "CONTACT",
      "name": "接点",
      "definition": "候補者との接点を記録した状態。応募完了を意味しない。"
    },
    {
      "code": "LINE_REGISTERED",
      "name": "LINE登録",
      "definition": "候補者のLINE登録を確認した状態。連絡先未取得の接点を否定しない。"
    },
    {
      "code": "SALON_TOUR",
      "name": "見学",
      "definition": "見学の実施を記録した状態。"
    },
    {
      "code": "INTERVIEW",
      "name": "面接",
      "definition": "面接の実施または面接段階を記録した状態。"
    },
    {
      "code": "PASSED",
      "name": "承諾",
      "definition": "現行Dashboardの承諾件数に使用する候補者状態。イベントコードSELECTION_PASSEDとは別概念として扱う。"
    },
    {
      "code": "OFFER",
      "name": "内定",
      "definition": "内定を提示または記録した状態。"
    },
    {
      "code": "EXPECTED_JOIN",
      "name": "入社予定",
      "definition": "入社予定日等を確認した入社前の状態。入社時点でEmployee Coreへライフサイクルを引き継ぐ。"
    },
    {
      "code": "WITHDRAWN",
      "name": "辞退・保管",
      "definition": "候補者が辞退し、採用活動の進行対象から外れた状態。削除を意味しない。"
    }
  ],
  "statusRules": {
    "isOrdinal": false,
    "transitionInference": "PROHIBITED",
    "unsetCode": "UNSET",
    "unsetName": "未設定",
    "note": "状態コードの並びだけから選考順序や自動遷移を推測しない"
  },
  "school": {
    "fieldCode": "SCHOOL_NAME",
    "formalName": "学校名",
    "dataType": "string_or_null",
    "maximumLength": 180,
    "normalization": [
      "Unicode NFKC",
      "前後空白除去",
      "空文字はnull"
    ],
    "masterType": "OPEN_VALUE",
    "automaticAbbreviationExpansion": false,
    "automaticGuessing": false,
    "placeholderAsFact": false,
    "missingPolicy": "正本で確認できない場合は空欄のまま確認対象とし、仮名や推測値を入力しない"
  },
  "events": [
    {
      "metricKey": "contacts",
      "code": "CONTACT_RECORDED",
      "name": "接点記録",
      "definition": "候補者との接点を1件記録する。"
    },
    {
      "metricKey": "lineRegistrations",
      "code": "LINE_REGISTERED",
      "name": "LINE登録",
      "definition": "LINE登録確認を1件記録する。"
    },
    {
      "metricKey": "salonTours",
      "code": "SALON_TOUR_COMPLETED",
      "name": "見学完了",
      "definition": "見学完了を1件記録する。"
    },
    {
      "metricKey": "interviews",
      "code": "INTERVIEW_COMPLETED",
      "name": "面接完了",
      "definition": "面接完了を1件記録する。"
    },
    {
      "metricKey": "passed",
      "code": "SELECTION_PASSED",
      "name": "選考通過",
      "definition": "選考通過イベントを1件記録する。候補者状態PASSED（承諾）とは同一視しない。"
    },
    {
      "metricKey": "offers",
      "code": "OFFER_ISSUED",
      "name": "内定提示",
      "definition": "内定提示を1件記録する。"
    },
    {
      "metricKey": "expectedJoiners",
      "code": "EXPECTED_JOIN_CONFIRMED",
      "name": "入社予定確認",
      "definition": "入社予定の確認を1件記録する。"
    }
  ],
  "eventInvalidationReasons": [
    {
      "code": "CANCELLED",
      "name": "キャンセル",
      "definition": "予定された見学、面接または入社予定がキャンセルされた。"
    },
    {
      "code": "NO_SHOW",
      "name": "無断欠席",
      "definition": "予定された見学、面接または入社予定に連絡なく現れなかった。"
    },
    {
      "code": "DELETED",
      "name": "誤登録・削除",
      "definition": "誤って記録されたイベントを集計対象から失効させる。監査記録自体の物理削除を意味しない。"
    },
    {
      "code": "WITHDRAWN",
      "name": "辞退",
      "definition": "候補者が入社予定を辞退した。現行契約ではexpectedJoinersにのみ使用できる。"
    }
  ],
