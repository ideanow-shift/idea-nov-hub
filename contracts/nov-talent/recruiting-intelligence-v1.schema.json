{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideanow-shift.github.io/contracts/nov-talent/recruiting-intelligence-v1.schema.json",
  "x-recruiting-intelligence-contract-version": "1.1.0",
  "title": "NOV Talent Recruiting Intelligence read-only response",
  "description": "Server-aggregated official-fact intelligence. Nullable metrics are PREPARING, never false zero. Priority candidates contain no contact details, notes, or evidence text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["recruiting_intelligence_contract_version", "generatedAt", "sourceCoverageState", "sourceAvailability", "currentPosition", "funnel", "graduationYears", "schoolProgress", "assigneeWorkload", "priorities", "fairResults", "managementDiagnostics", "planningComparison", "targets"],
      "additionalProperties": false,
      "properties": {
        "recruiting_intelligence_contract_version": { "const": "1.1.0" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sourceCoverageState": { "enum": ["COMPLETE", "PREPARING"] },
        "sourceAvailability": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "currentPosition": { "$ref": "#/$defs/section" },
        "funnel": { "$ref": "#/$defs/section" },
        "graduationYears": { "$ref": "#/$defs/section" },
        "schoolProgress": { "$ref": "#/$defs/section" },
        "assigneeWorkload": { "$ref": "#/$defs/section" },
        "priorities": { "$ref": "#/$defs/section" },
        "fairResults": { "$ref": "#/$defs/section" },
        "managementDiagnostics": { "$ref": "#/$defs/section" },
        "planningComparison": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "rows"],
          "properties": {
            "state": { "enum": ["READY", "PREPARING"] },
            "rows": { "type": "array" }
          }
        },
        "targets": { "type": "object", "required": ["state", "candidateTarget", "achievementRate"], "additionalProperties": false, "properties": { "state": { "const": "UNSET" }, "candidateTarget": { "type": "null" }, "achievementRate": { "type": "null" } } }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["state"],
      "properties": { "state": { "enum": ["READY", "PREPARING"] } }
    }
  }
}
