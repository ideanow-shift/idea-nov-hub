\set ON_ERROR_STOP on
create role anon nologin;
create role authenticated nologin;
create role service_role nologin bypassrls;
create schema core;
create schema projection;
create schema accounting;
create schema store_operations_uat_private;
create schema auth;

create table core.employees (
  employee_id uuid primary key,
  status text not null,
  effective_from date not null,
  effective_to date
);
create table core.employee_identities (
  employee_id uuid primary key references core.employees,
  identity_status text not null
);
create table core.employee_store_assignments (
  employee_id uuid not null references core.employees,
  store_id uuid not null,
  status text not null,
  assignment_kind text not null,
  effective_from date not null,
  effective_to date
);
create table core.corporation_store_relationships (
  store_id uuid not null,
  corporation_id uuid not null,
  relationship_type text not null
);
create table projection.store_master_v1 (
  store_id uuid primary key,
  store_code text not null,
  in_official_population boolean not null,
  is_active boolean not null
);
create table store_operations_uat_private.auth_identity_binding_decisions (
  binding_key text not null,
  employee_id uuid not null,
  auth_subject_id uuid not null,
  effective_at timestamptz not null,
  decision_sequence bigint not null,
  decision text not null
);
create table auth.users (id uuid primary key,deleted_at timestamptz,banned_until timestamptz);
create table store_operations_uat_private.approved_identities (
  artifact_digest text not null,identity_key text not null,employee_id uuid not null,
  role_key text not null,status text not null,effective_from date not null,effective_to date,
  primary key(artifact_digest,identity_key)
);
create table store_operations_uat_private.role_attestation_decisions (
  attestation_key text not null,
  employee_id uuid not null,
  audience text not null,
  role_key text not null,
  effective_at timestamptz not null,
  decision_sequence bigint not null,
  decision text not null
);
create function accounting.current_consumer_access_contracts(uuid,uuid,date,text)
returns table(contract_id uuid)
language sql stable
as $$ select gen_random_uuid() $$;

insert into core.employees values('10000000-0000-4000-8000-000000000001','active',current_date-1,null);
insert into core.employee_identities values('10000000-0000-4000-8000-000000000001','active');
insert into auth.users values('20000000-0000-4000-8000-000000000001',null,null);
insert into core.employee_store_assignments
select '10000000-0000-4000-8000-000000000001',('30000000-0000-4000-8000-'||lpad(i::text,12,'0'))::uuid,
  'active','primary',current_date-1,null from generate_series(1,20)i;
insert into core.corporation_store_relationships
select ('30000000-0000-4000-8000-'||lpad(i::text,12,'0'))::uuid,'40000000-0000-4000-8000-000000000001','accounting'
from generate_series(1,20)i;
insert into projection.store_master_v1
select ('30000000-0000-4000-8000-'||lpad(i::text,12,'0'))::uuid,lpad(i::text,2,'0'),true,true from generate_series(1,20)i;
insert into store_operations_uat_private.auth_identity_binding_decisions
values('binding','10000000-0000-4000-8000-000000000001','20000000-0000-4000-8000-000000000001',statement_timestamp(),1,'grant');
insert into store_operations_uat_private.role_attestation_decisions
values('role','10000000-0000-4000-8000-000000000001','store_operations_staging_v1','executive',statement_timestamp(),1,'grant');
insert into store_operations_uat_private.approved_identities
values(repeat('a',64),'uat-executive','10000000-0000-4000-8000-000000000001','executive','approved',current_date-1,null);
