{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideanow-shift.github.io/contracts/nov-talent/recruiting-target-v1.schema.json",
  "title": "NOV Talent Recruiting Target Contract",
  "x-recruiting-target-contract-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recruiting_target_contract_version", "kind", "targets", "sourceAvailability"],
      "properties": {
        "recruiting_target_contract_version": { "const": "1.0.0" },
        "kind": { "enum": ["CURRENT", "DRAFTS", "HISTORY"] },
        "sourceAvailability": { "const": true },
        "targets": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/target" } }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "graduationYear", "targetType", "targetPeriod", "scope", "targetCount", "version", "rowVersion", "state", "effectivePeriod", "reason", "approvedBy", "approvedAt", "supersededByTargetId", "supersededAt", "createdAt", "updatedAt"],
      "properties": {
        "targetId": { "type": "string", "format": "uuid" },
        "graduationYear": { "type": "integer", "minimum": 2020, "maximum": 2100 },
        "targetType": { "enum": ["OFFERED", "OFFER_ACCEPTED"] },
        "targetPeriod": { "type": "object", "additionalProperties": false, "required": ["code", "start", "end"], "properties": { "code": { "type": "string" }, "start": { "type": "string", "format": "date" }, "end": { "type": "string", "format": "date" } } },
        "scope": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "COMPANY" }, "id": { "type": "null" } } },
        "targetCount": { "type": "integer", "minimum": 0 },
        "version": { "type": "integer", "minimum": 1 },
        "rowVersion": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["DRAFT", "APPROVED", "SUPERSEDED"] },
        "effectivePeriod": { "type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } } },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "approvedBy": { "type": ["string", "null"], "format": "uuid" },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" },
        "supersededByTargetId": { "type": ["string", "null"], "format": "uuid" },
        "supersededAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
