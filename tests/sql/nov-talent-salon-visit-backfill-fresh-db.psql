\set ON_ERROR_STOP on

create schema if not exists extensions;
create extension if not exists pgcrypto with schema extensions;
create schema if not exists nov_talent_internal;

do $setup_roles$
begin
  if not exists(select 1 from pg_roles where rolname='anon') then create role anon nologin; end if;
  if not exists(select 1 from pg_roles where rolname='authenticated') then create role authenticated nologin; end if;
  if not exists(select 1 from pg_roles where rolname='service_role') then create role service_role nologin bypassrls; end if;
end
$setup_roles$;

create table public.nov_talent_candidates_v1 (
  candidate_id uuid primary key,
  graduation_year smallint not null,
  is_active boolean not null default true
);
create table public.nov_talent_recruitment_events_v1 (
  event_id uuid primary key,
  candidate_id uuid not null references public.nov_talent_candidates_v1(candidate_id) on delete restrict,
  event_code text not null,
  event_date date not null,
  source_type text not null,
  source_row_no integer not null,
  source_field_code text not null,
  source_fingerprint text not null,
  event_state text not null,
  is_active boolean not null default true,
  invalidated_at timestamptz,
  correction_of_event_id uuid references public.nov_talent_recruitment_events_v1(event_id) on delete restrict
);

\ir ../../supabase/migrations/20260811224534_nov_talent_recruiting_actual_fact_foundation.sql
\ir ../../supabase/migrations/20260812035051_nov_talent_recruiting_actual_fact_fk_indexes.sql
\ir ../../supabase/migrations/20260812120633_nov_talent_recruiting_contact_backfill_preparation.sql
\ir ../../supabase/migrations/20260813063843_nov_talent_salon_visit_backfill_preparation.sql

create function pg_temp.assert_true(value boolean, message text) returns void
language plpgsql as $assert$
begin
  if value is not true then raise exception 'ASSERTION_FAILED: %',message; end if;
end
$assert$;

