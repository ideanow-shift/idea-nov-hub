{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideanov.example/contracts/nov-talent/workspace/v1.schema.json",
  "title": "NOV Talent Workspace Contract v1.0.0",
  "description": "Canonical Workspace response contract shared by the Edge API, frontend validator, generated types, tests, and release gates.",
  "x-workspace-contract-version": "1.0.0",
  "$ref": "#/$defs/WorkspaceResponseV1",
  "$defs": {
    "NullableString": { "type": ["string", "null"] },
    "NonNegativeInteger": { "type": "integer", "minimum": 0 },
    "NullableNonNegativeInteger": { "type": ["integer", "null"], "minimum": 0 },
    "PositiveVersion": { "type": "integer", "minimum": 1 },
    "NullablePositiveVersion": { "type": ["integer", "null"], "minimum": 1 },
    "Date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "NullableDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "Timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "NullableTimestamp": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "Uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "NullableUuid": { "type": ["string", "null"], "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "WorkspaceResponseV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data", "meta"],
      "properties": {
        "ok": { "const": true },
        "data": { "$ref": "#/$defs/WorkspaceDataV1" },
        "meta": { "$ref": "#/$defs/WorkspaceMetaV1" }
      }
    },
    "WorkspaceMetaV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "requestId", "source", "version"],
      "properties": {
        "generatedAt": { "$ref": "#/$defs/Timestamp" },
        "requestId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "WorkspaceDataV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_contract_version", "accessProfile", "canWrite", "dashboard", "fairMasters",
        "fiscalYear", "overview", "partialStatus", "payloadMode", "schoolMasters", "students",
        "summary", "todayTasks", "unlinkedSelectionHistory"
      ],
      "properties": {
        "workspace_contract_version": { "const": "1.0.0" },
        "accessProfile": { "enum": ["executive", "full", "recruiter"] },
        "canWrite": { "type": "boolean" },
        "dashboard": { "$ref": "#/$defs/Dashboard" },
        "fairMasters": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/FairMaster" } },
        "fiscalYear": { "enum": ["2027", "2028", "all"] },
        "overview": { "$ref": "#/$defs/WorkspaceOverview" },
        "partialStatus": { "$ref": "#/$defs/PartialStatus" },
        "payloadMode": { "const": "workspace" },
        "schoolMasters": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/SchoolMaster" } },
        "students": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/Student" } },
        "summary": { "$ref": "#/$defs/DashboardSummary" },
        "todayTasks": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/TodayTask" } },
        "unlinkedSelectionHistory": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/UnlinkedSelection" } }
      }
    },
    "WorkspaceOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contacts", "entries", "exactLinkSuggestions", "mapped", "manual", "offers", "ownerReview", "primaryCandidates", "quarantined", "remainingManual", "total"],
      "properties": {
        "contacts": { "$ref": "#/$defs/NonNegativeInteger" },
        "entries": { "$ref": "#/$defs/NonNegativeInteger" },
        "exactLinkSuggestions": { "$ref": "#/$defs/NonNegativeInteger" },
        "mapped": { "$ref": "#/$defs/NonNegativeInteger" },
        "manual": { "$ref": "#/$defs/NonNegativeInteger" },
        "offers": { "$ref": "#/$defs/NonNegativeInteger" },
        "ownerReview": { "$ref": "#/$defs/NonNegativeInteger" },
        "primaryCandidates": { "$ref": "#/$defs/NonNegativeInteger" },
        "quarantined": { "$ref": "#/$defs/NonNegativeInteger" },
        "remainingManual": { "$ref": "#/$defs/NonNegativeInteger" },
        "total": { "$ref": "#/$defs/NonNegativeInteger" }
      }
    },
    "PartialStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retryCount", "state", "unavailableViews"],
      "properties": {
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "state": { "enum": ["complete", "partial"] },
        "unavailableViews": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "DashboardSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contacts", "expectedJoiners", "interviews", "lineRegistrations", "offers", "passed", "salonTours"],
      "properties": {
        "contacts": { "$ref": "#/$defs/NonNegativeInteger" },
        "expectedJoiners": { "$ref": "#/$defs/NonNegativeInteger" },
        "interviews": { "$ref": "#/$defs/NonNegativeInteger" },
        "lineRegistrations": { "$ref": "#/$defs/NonNegativeInteger" },
        "offers": { "$ref": "#/$defs/NonNegativeInteger" },
        "passed": { "$ref": "#/$defs/NonNegativeInteger" },
        "salonTours": { "$ref": "#/$defs/NonNegativeInteger" }
      }
    },
    "DashboardAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCount", "entries", "eventCount", "fairCount", "graduation2027", "graduation2028", "interviewHistory", "interviewPlanned", "lineRegistrations", "offeredElsewhere", "offers", "rejected", "salonTourCompleted", "salonTourPlanned", "schoolCount", "todayActions", "withdrawals"],
      "properties": {
        "candidateCount": { "type": "boolean" }, "entries": { "type": "boolean" }, "eventCount": { "type": "boolean" },
        "fairCount": { "type": "boolean" }, "graduation2027": { "type": "boolean" }, "graduation2028": { "type": "boolean" },
        "interviewHistory": { "type": "boolean" }, "interviewPlanned": { "type": "boolean" }, "lineRegistrations": { "type": "boolean" },
        "offeredElsewhere": { "type": "boolean" }, "offers": { "type": "boolean" }, "rejected": { "type": "boolean" },
        "salonTourCompleted": { "type": "boolean" }, "salonTourPlanned": { "type": "boolean" }, "schoolCount": { "type": "boolean" },
        "todayActions": { "type": "boolean" }, "withdrawals": { "type": "boolean" }
      }
    },
    "Dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "candidateCount", "entries", "eventCount", "fairCount", "graduation2027", "graduation2028", "interviewHistory", "interviewPlanned", "lineRegistrations", "offeredElsewhere", "offers", "rejected", "salonTourCompleted", "salonTourPlanned", "schoolCount", "selectionHistoryCount", "todayActions", "undatedActions", "unlinkedInterviewHistoryCount", "withdrawals"],
      "properties": {
        "availability": { "$ref": "#/$defs/DashboardAvailability" },
        "candidateCount": { "$ref": "#/$defs/NonNegativeInteger" }, "entries": { "$ref": "#/$defs/NonNegativeInteger" },
        "eventCount": { "$ref": "#/$defs/NonNegativeInteger" }, "fairCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "graduation2027": { "$ref": "#/$defs/NonNegativeInteger" }, "graduation2028": { "$ref": "#/$defs/NonNegativeInteger" },
        "interviewHistory": { "$ref": "#/$defs/NonNegativeInteger" }, "interviewPlanned": { "$ref": "#/$defs/NonNegativeInteger" },
        "lineRegistrations": { "$ref": "#/$defs/NonNegativeInteger" }, "offeredElsewhere": { "$ref": "#/$defs/NonNegativeInteger" },
        "offers": { "$ref": "#/$defs/NonNegativeInteger" }, "rejected": { "$ref": "#/$defs/NonNegativeInteger" },
        "salonTourCompleted": { "$ref": "#/$defs/NonNegativeInteger" }, "salonTourPlanned": { "$ref": "#/$defs/NonNegativeInteger" },
        "schoolCount": { "$ref": "#/$defs/NonNegativeInteger" }, "selectionHistoryCount": { "$ref": "#/$defs/NonNegativeInteger" },
        "todayActions": { "$ref": "#/$defs/NonNegativeInteger" }, "undatedActions": { "$ref": "#/$defs/NonNegativeInteger" },
        "unlinkedInterviewHistoryCount": { "$ref": "#/$defs/NonNegativeInteger" }, "withdrawals": { "$ref": "#/$defs/NonNegativeInteger" }
      }
    },
    "SelectionHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "assignedTo", "code", "date", "id", "label", "notes", "version"],
      "properties": {
        "active": { "type": "boolean" }, "assignedTo": { "$ref": "#/$defs/NullableString" }, "code": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/Date" }, "id": { "$ref": "#/$defs/Uuid" }, "label": { "type": "string", "minLength": 1 },
        "notes": { "$ref": "#/$defs/NullableString" }, "version": { "$ref": "#/$defs/PositiveVersion" }
      }
    },
    "EventHistory": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "assignedTo", "code", "content", "date", "id", "label", "notes", "state", "version"],
      "properties": {
        "active": { "type": "boolean" }, "assignedTo": { "$ref": "#/$defs/NullableString" }, "code": { "type": "string", "minLength": 1 },
        "content": { "$ref": "#/$defs/NullableString" }, "date": { "$ref": "#/$defs/Date" }, "id": { "$ref": "#/$defs/Uuid" },
        "label": { "type": "string", "minLength": 1 }, "notes": { "$ref": "#/$defs/NullableString" },
        "state": { "$ref": "#/$defs/NullableString" }, "version": { "$ref": "#/$defs/PositiveVersion" }
      }
    },
    "NextAction": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "assignedTo", "code", "completedAt", "date", "id", "label", "notes", "state", "version"],
      "properties": {
        "active": { "type": "boolean" }, "assignedTo": { "$ref": "#/$defs/NullableString" }, "code": { "type": "string", "minLength": 1 },
        "completedAt": { "$ref": "#/$defs/NullableTimestamp" }, "date": { "$ref": "#/$defs/NullableDate" }, "id": { "$ref": "#/$defs/Uuid" },
        "label": { "type": "string", "minLength": 1 }, "notes": { "$ref": "#/$defs/NullableString" },
        "state": { "$ref": "#/$defs/NullableString" }, "version": { "$ref": "#/$defs/PositiveVersion" }
      }
    },
    "Student": {
      "type": "object", "additionalProperties": false,
      "required": ["applicationNo", "businessDate", "classification", "classificationLabel", "displayName", "email", "faculty", "graduationYear", "kana", "lineIdentifier", "lineRegistrationDate", "legacyNoPresent", "mappingStatus", "nextActionAt", "nextActionLabel", "offerDate", "expectedJoinDate", "plannedStore", "phone", "acquisitionSource", "assignee", "notes", "preferredStore", "primaryEligible", "profileVersion", "supplementVersion", "reasonLabels", "recordId", "schoolId", "fairId", "school", "sourceCode", "sourceLabel", "sourceKeyStatus", "status", "statusCode", "suggestedTargetRecordId", "suggestionCategory", "contactHistory", "eventHistory", "nextActions", "selectionHistory"],
      "properties": {
        "applicationNo": { "$ref": "#/$defs/NullableString" }, "businessDate": { "$ref": "#/$defs/NullableDate" },
        "classification": { "type": "string", "minLength": 1 }, "classificationLabel": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }, "email": { "$ref": "#/$defs/NullableString" },
        "faculty": { "$ref": "#/$defs/NullableString" }, "graduationYear": { "type": "integer", "minimum": 2026, "maximum": 2035 },
        "kana": { "$ref": "#/$defs/NullableString" }, "lineIdentifier": { "$ref": "#/$defs/NullableString" },
        "lineRegistrationDate": { "$ref": "#/$defs/NullableDate" }, "legacyNoPresent": { "type": "boolean" },
        "mappingStatus": { "type": "string", "minLength": 1 }, "nextActionAt": { "$ref": "#/$defs/NullableDate" },
        "nextActionLabel": { "$ref": "#/$defs/NullableString" }, "offerDate": { "$ref": "#/$defs/NullableDate" },
        "expectedJoinDate": { "$ref": "#/$defs/NullableDate" }, "plannedStore": { "$ref": "#/$defs/NullableString" },
        "phone": { "$ref": "#/$defs/NullableString" }, "acquisitionSource": { "$ref": "#/$defs/NullableString" },
        "assignee": { "$ref": "#/$defs/NullableString" }, "notes": { "$ref": "#/$defs/NullableString" },
        "preferredStore": { "$ref": "#/$defs/NullableString" }, "primaryEligible": { "type": "boolean" },
        "profileVersion": { "$ref": "#/$defs/NullablePositiveVersion" }, "supplementVersion": { "$ref": "#/$defs/NullablePositiveVersion" },
        "reasonLabels": { "type": "array", "maxItems": 6, "items": { "type": "string" } }, "recordId": { "$ref": "#/$defs/Uuid" },
        "schoolId": { "$ref": "#/$defs/NullableUuid" }, "fairId": { "$ref": "#/$defs/NullableUuid" }, "school": { "$ref": "#/$defs/NullableString" },
        "sourceCode": { "type": "string", "minLength": 1 }, "sourceLabel": { "type": "string", "minLength": 1 },
        "sourceKeyStatus": { "type": "string", "minLength": 1 }, "status": { "type": "string", "minLength": 1 },
        "statusCode": { "$ref": "#/$defs/NullableString" }, "suggestedTargetRecordId": { "$ref": "#/$defs/NullableUuid" },
        "suggestionCategory": { "enum": ["NONE", "EXACT1", "AMBIGUOUS"] },
        "contactHistory": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/EventHistory" } },
        "eventHistory": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/EventHistory" } },
        "nextActions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/NextAction" } },
        "selectionHistory": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/SelectionHistory" } }
      }
    },
    "SchoolMaster": {
      "type": "object", "additionalProperties": false,
      "required": ["assigned_to", "faculty_name", "is_active", "school_id", "school_name", "version"],
      "properties": {
        "assigned_to": { "$ref": "#/$defs/NullableString" }, "faculty_name": { "$ref": "#/$defs/NullableString" },
        "is_active": { "type": "boolean" }, "school_id": { "$ref": "#/$defs/Uuid" },
        "school_name": { "type": "string", "minLength": 1 }, "version": { "$ref": "#/$defs/PositiveVersion" }
      }
    },
    "FairMaster": {
      "type": "object", "additionalProperties": false,
      "required": ["assigned_to", "contact_count", "created_at", "event_date", "event_format", "expected_contacts", "fair_id", "fair_name", "hire_count", "interview_count", "is_active", "line_registration_count", "note", "offer_count", "organizer_name", "participant_count", "participating_salons", "participation_fee", "salon_tour_count", "total_attendance", "venue", "version"],
      "properties": {
        "assigned_to": { "$ref": "#/$defs/NullableString" }, "contact_count": { "$ref": "#/$defs/NullableNonNegativeInteger" },
        "created_at": { "$ref": "#/$defs/Timestamp" }, "event_date": { "$ref": "#/$defs/Date" },
        "event_format": { "$ref": "#/$defs/NullableString" }, "expected_contacts": { "$ref": "#/$defs/NullableNonNegativeInteger" },
        "fair_id": { "$ref": "#/$defs/Uuid" }, "fair_name": { "type": "string", "minLength": 1 },
        "hire_count": { "$ref": "#/$defs/NullableNonNegativeInteger" }, "interview_count": { "$ref": "#/$defs/NullableNonNegativeInteger" },
        "is_active": { "type": "boolean" }, "line_registration_count": { "$ref": "#/$defs/NullableNonNegativeInteger" },
        "note": { "$ref": "#/$defs/NullableString" }, "offer_count": { "$ref": "#/$defs/NullableNonNegativeInteger" },
        "organizer_name": { "$ref": "#/$defs/NullableString" }, "participant_count": { "$ref": "#/$defs/NullableNonNegativeInteger" },
        "participating_salons": { "$ref": "#/$defs/NullableNonNegativeInteger" }, "participation_fee": { "type": ["number", "null"], "minimum": 0 },
        "salon_tour_count": { "$ref": "#/$defs/NullableNonNegativeInteger" }, "total_attendance": { "$ref": "#/$defs/NullableNonNegativeInteger" },
        "venue": { "$ref": "#/$defs/NullableString" }, "version": { "$ref": "#/$defs/PositiveVersion" }
      }
    },
    "TodayTask": {
      "type": "object", "additionalProperties": false,
      "required": ["assignedTo", "candidateId", "dueDate", "label"],
      "properties": {
        "assignedTo": { "$ref": "#/$defs/NullableString" }, "candidateId": { "$ref": "#/$defs/Uuid" },
        "dueDate": { "$ref": "#/$defs/Date" }, "label": { "type": "string", "minLength": 1 }
      }
    },
    "UnlinkedSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "date", "label", "sourceRowNo", "sourceType", "version"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }, "date": { "$ref": "#/$defs/Date" },
        "label": { "type": "string", "minLength": 1 }, "sourceRowNo": { "type": "integer", "minimum": 1 },
        "sourceType": { "type": "string", "minLength": 1 }, "version": { "$ref": "#/$defs/PositiveVersion" }
      }
    }
  }
}
